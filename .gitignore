# 但 manifest 进 git（per-dataset ingest 知识，是项目资产）
!data/*/manifest.yaml
# 抽样脚本进 git（可复现夹具，不依赖外部全量数据）
!scripts/**

# 分析中间产物
results/*.csv
results/data/
results/figures/
results/tables/
results/_deseq2_tmp/
results/_hdWGCNA_tmp/
# hdWGCNA 真跑副产物：拓扑重叠矩阵（~11MB .rda），每次运行生成
TOM/
