*.tmp

# scanpy 自动创建的 figures/ 目录（CWD root）
figures/

# === 敏感上下文（GitHub 仓库项目强制保留，禁止删除）===
# vault 规划文件（含 PI 决策/审计），不进 GitHub
planning/

# === 项目级 secrets ===
.env
.env.local
secrets/

# === worktree（并行多 PR 工作区，不追踪到内部 git）===
.worktrees/

# === 参考代码（仅本地 lookup，不上 GitHub）===
# 早期 GCPL_scRNA notebooks + 学生 reference code，框架成熟后可删
references/*

# 例外：marker 库（references/markers/）是跨项目长期积累的科研资产，进 git
!references/markers/
!references/markers/**

# 例外：disease_ontology（references/disease_ontology/）跨项目共享的疾病本体，进 git
