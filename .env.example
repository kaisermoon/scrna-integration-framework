# stage6 多模型共识注释（mLLMCelltype）——各家 API key 与 Base URL 模板
# =========================================================================
# mLLMCelltype 按模型名前缀自动路由到各家 provider，无需 OpenRouter。
# 用哪几个模型在 notebook 的 models=[...] 中指定；只填要用的 provider。
#
# 每个 provider 一组 KEY + BASE_URL。
# BASE_URL 决定 API 端点：留空 = 官方默认；自建/Azure 代理填自定义地址。
# 国内用户注意：OpenAI/Anthropic 可能需要代理 URL 才能访问。

# ===== OpenAI（或兼容端点，如 Azure、国内代理）=====
OPENAI_API_KEY=
OPENAI_BASE_URL=                 # 留空=官方默认 https://api.openai.com/v1

# ===== Anthropic =====
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# ===== DeepSeek（国内，便宜）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ===== 阿里 Qwen（注意国内/国际端点不同）=====
QWEN_API_KEY=
QWEN_BASE_URL=                   # 国内: https://dashscope.aliyuncs.com/compatible-mode/v1
                                 # 国际: https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# ===== Google Gemini =====
GEMINI_API_KEY=
GEMINI_BASE_URL=                  # 留空=官方默认

# ===== OpenRouter（可选——项目默认走各家直连，仅当需要统一网关时使用）=====
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
