# ============================================================
# LLM 配置（scRNA-seq 整合分析框架）
# ============================================================
# 框架使用 LLM_GROUP{N}_* Schema 配置 LLM provider。
# 每个 GROUP 是一个独立的 provider 端点。
# 至少配置一个 GROUP 才能启用 LLM 注释功能（mLLMCelltype / 证据汇总 / 逐簇叙述）。

# --- Group 1（必填：至少一个 group）---
LLM_GROUP1_PROVIDER=anthropic
LLM_GROUP1_BASE_URL=https://api.anthropic.com
LLM_GROUP1_API_KEY=sk-ant-xxx
LLM_GROUP1_MODEL_HAIKU=claude-haiku-4-5-20241022
LLM_GROUP1_MODEL_SONNET=claude-sonnet-4-6-20250514
LLM_GROUP1_MODEL_OPUS=claude-opus-4-20250514

# --- Group 2（可选：增加多模型共识的多样性）---
# LLM_GROUP2_PROVIDER=deepseek
# LLM_GROUP2_BASE_URL=https://api.deepseek.com
# LLM_GROUP2_API_KEY=sk-xxx
# LLM_GROUP2_MODEL_HAIKU=deepseek-chat
# LLM_GROUP2_MODEL_SONNET=deepseek-chat

# --- Group 3（可选）---
# LLM_GROUP3_PROVIDER=openai
# LLM_GROUP3_BASE_URL=https://api.openai.com/v1
# LLM_GROUP3_API_KEY=sk-xxx
# LLM_GROUP3_MODEL_HAIKU=gpt-4.1-nano
# LLM_GROUP3_MODEL_SONNET=gpt-4.1-mini

# --- 默认 GROUP（可选，不填则使用 GROUP1）---
# LLM_DEFAULT_GROUP=1

# ============================================================
# 注意事项:
# - 本文件已在 .gitignore 中，不会进入 git
# - 复制本文件为 .env 并填入真实 key 后即可使用
# - 至少配一个 GROUP 的真实 key，框架才能启用 LLM 注释
# - 多 GROUP 配置后，mLLMCelltype 会用各 GROUP 的 haiku 模型做多模型共识
# - sonnet 模型用于证据汇总和逐簇判决
# ============================================================
